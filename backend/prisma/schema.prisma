datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Cliente {
  id                     Int      @id @default(autoincrement())
  nome                   String
  telefone               String
  primeiroContato        DateTime?
  ultimoContato          DateTime?
  formaProspeccao        String?
  areaAtuacao            String?
  resumoDemanda          String?
  resumoUltimaTratativa  String?
  motivoNaoContratado    String?
  dataCadastro           DateTime @default(now())
}